<% if alert %>
<div
  class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 dark:text-red-400"
  role="alert"
>
  <span class="font-medium"><%= alert %></span>
</div>
<% end %>
<section
  class="bg-gray-50 min-h-screen flex items-center justify-center px-6 py-8"
>
  <div class="w-full max-w-md">
    <h1 class="text-2xl font-bold text-center text-gray-900 mb-6">
      Login Page
    </h1>

    <div class="bg-white rounded-lg shadow-lg p-8">
      <h2 class="text-xl font-bold text-gray-900 mb-6">
        Sign in to your account
      </h2>

      <%= form_with url: sessions_path, method: :post, local: true, class:
      "space-y-5" do |form| %>

      <div>
        <%= form.label :email, "Your email", class: "block mb-2 text-sm
        font-medium text-gray-900" %> <%= form.email_field :email, placeholder:
        "name@example.com", required: true, class: "w-full p-3 border
        border-gray-300 rounded-lg focus:outline-none focus:ring-2
        focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "block mb-2 text-sm
        font-medium text-gray-900" %> <%= form.password_field :password,
        placeholder: "••••••••", required: true, class: "w-full p-3 border
        border-gray-300 rounded-lg focus:outline-none focus:ring-2
        focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <%= form.submit "Sign in", class: "w-full bg-blue-600 hover:bg-blue-700
      text-white font-medium rounded-lg px-5 py-3 transition cursor-pointer" %>

      <p class="text-sm text-gray-500 text-center">
        Don't have an account yet? <%= link_to "Sign up", signup_path, class:
        "font-medium text-blue-600 hover:underline" %>
      </p>

      <% end %>
    </div>
  </div>
</section>
