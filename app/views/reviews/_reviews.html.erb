<section class="w-full mt-13  ">
  <div class="flex items-center justify-between mb-5">
    <h2 class="text-2xl md:text-3xl font-semibold text-gray-700">
      Latest Reviews
    </h2>
    <span class="text-sm text-gray-500">
      Total: <%=@reviews.size %> reviews
    </span>
  </div>

  <div class="grid grid-cols-1 gap-4">
    <% @reviews.each do |review| %>

      <div class="border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md transition">

        <div class="flex items-center justify-between gap-3 mb-3">

          <p class="font-semibold text-gray-800">
            <%= review.user.username %>
          </p>

          <%= link_to review.movie.title,
              movie_path(review.movie),
              class: "text-blue-600 hover:underline text-sm font-medium" %>

        </div>

        <p class="text-gray-600 leading-relaxed break-words">
          <%= review.content %>
        </p>

      </div>

    <% end %>

  </div>

  <% if @reviews.empty? %>
    <p class="text-center text-gray-500 py-8">
      No reviews yet. Be the first to review a movie!
    </p>
  <% end %>

</section>