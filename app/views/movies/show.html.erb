<div class="max-w-7xl mx-auto px-5 ">
    <div class="mt-3">
        <a href="/" class="ml-3 bg-blue-400 px-2 py-2 rounded text-center text-neutral-700">←Home page</a>
    </div>
    <div class="flex flex-col md:flex-row gap-8 items-start mt-5">    
        <div class="w-full md:w-1/3 flex justify-center md:sticky md:top-6">
            <div class="flex flex-col items-center">
                <%= image_tag "https://image.tmdb.org/t/p/w500#{@movie.poster_path}",
                    alt: @movie.title,
                    class: "w-100 h-140  object-contain rounded-xl " %>

                <h1 class="font-bold text-2xl lg:text-3xl text-center mt-3 text-neutral-700">
                    <%= @movie.title %>
                </h1>
            </div>
        </div>

        <div class="w-full md:w-2/3 flex flex-col gap-5">


            <div class="border border-gray-300 rounded-xl p-5 shadow-sm">
                <h2 class="font-bold text-xl mb-4">Movie Details</h2>

                <p class="text-gray-700 leading-relaxed mb-4">
                    <%= @movie.overview %>
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <p><strong>Duration:</strong> <%= @movie.runtime %> minutes</p>
                    <p><strong>Released Date:</strong> <%= @movie.release_date %></p>
                    <p><strong>Popularity:</strong> <%= @movie.popularity %></p>
                    <p><strong>Budget:</strong> $<%= @movie.budget %></p>
                    <p><strong>Average Vote:</strong> <%= @movie.vote_average %>/10</p>
                    <p><strong>Total Votes:</strong> <%= @movie.vote_count %></p>
                </div>

                <% if @movie.homepage.present? %>
                    <p class="mt-4">
                        <strong>Website:</strong>
                        <%= link_to @movie.homepage, @movie.homepage,
                            target: "_blank",
                            class: "text-blue-600 underline break-all" %>
                    </p>
                <% end %>
            </div>

            
            <div class="border border-gray-300 rounded-xl p-5 shadow-sm mb-5">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="font-bold text-xl">Reviews</h2>
                    <span class="text-sm text-gray-500">
                        <%= @movie.reviews.count %> reviews
                    </span> 
                </div>

                <div class="max-h-96 overflow-y-auto pr-2">
                    <% if @movie.reviews.any? %>
                        <% @movie.reviews.each do |review| %>
                            <div class="border-b border-gray-200 py-4">
                                <p class="font-semibold text-gray-800">
                                    <%= review.user.username %>
                                </p>

                                <p class="text-gray-600 mt-2 leading-relaxed break-words">
                                    <%= review.content %>
                                </p>

                                <% if current_user && current_user.id == review.user_id %>
                                    <div class="flex gap-3 mt-3">
                                        <%= link_to "Edit",
                                            edit_movie_review_path(@movie, review),
                                            class: "bg-blue-500 text-white rounded px-3 py-1 text-sm" %>

                                        <%= button_to "Delete",
                                            movie_review_path(@movie, review),
                                            method: :delete,
                                            class: "bg-red-500 text-white rounded px-3 py-1 text-sm" %>
                                    </div>
                                <% end %>
                            </div>
                        <% end %>
                    <% else %>
                        <p class="text-gray-500 py-4">
                            No reviews yet. Be the first to review this movie!
                        </p>
                    <% end %>
                </div>

              
                <div class="mt-5 border-t border-gray-200 pt-4">
                    <h3 class="font-semibold text-lg mb-2">Write your review</h3>

                    <% if current_user %>
                        <%= form_with model: [@movie, Review.new] do |f| %>
                            <%= f.text_area :content,
                                rows: 3,
                                placeholder: "Share your thoughts about this movie...",
                                class: "w-full border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-400 p-3" %>

                            <%= f.submit "Submit Review",
                                class: "bg-blue-500 hover:bg-blue-600 text-white p-2 px-4 rounded-lg mt-2 cursor-pointer" %>
                        <% end %>
                    <% else %>
                        <p class="text-gray-600">
                            Please <%= link_to "login", login_path,
                                class: "text-blue-600 underline" %> to write a review.
                        </p>
                    <% end %>
                </div>
            </div>

        </div>
    </div>
</div>
