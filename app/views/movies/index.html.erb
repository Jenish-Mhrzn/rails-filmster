<div class="min-h-screen bg-neutral-100 py-6 px-4 sm:px-6 ">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 ">


    <aside class="w-full lg:w-1/3 order-2 lg:order-1 ">
      <%= render 'reviews/reviews', reviews: @reviews %>
    </aside>

  
    <main class="w-full lg:w-2/3 order-1 lg:order-2 flex flex-col gap-8">
      <section class="w-full px-3 lg:w-xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-normal text-gray-600 mb-3 text-center">Find Movies</h1>

        <%= form_with url: movies_path, method: :get, class: "flex items-center gap-2" do %>
          <%= text_field_tag :query, params[:query],
            placeholder: "Enter movie name",
            class: "w-full flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <%= submit_tag "Search", class: "bg-green-400 p-2 rounded-xl text-neutral-700 cursor-pointer" %>
        <% end %>
      </section>

      <section class="w-full">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            <% if @movies.empty? %>
                <h1>No movies found..</h1>
            <% else %>
              <% @movies.each do |movie| %>
                <%= link_to movie_path(movie.id) do %>
                  <div class="bg-white shadow-xl rounded-lg transition-all duration-300 ease-in-out hover:-translate-y-1">

                    <%= image_tag(
                      "https://image.tmdb.org/t/p/w500#{movie.poster_path}",
                      alt: movie.title,
                      class: "w-full rounded-t-lg"
                    ) %>

                    <h2 class="text-center py-2">
                      <% if movie.title.length > 25 %>
                        <%= movie.title.slice(0, 25) + "..." %>
                      <% else %>
                        <%= movie.title %>
                      <% end %>
                    </h2>

                  </div>
                <% end %>
              <% end %>
            <% end %>
        </div>
      </section>

    </main>
  </div>
</div>